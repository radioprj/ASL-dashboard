[Unit]
Description=ASL Dashboard - kolektor stanu Asteriska (rpt lstats / rpt xnode)
After=asterisk.service
Wants=asterisk.service

[Service]
Type=simple
User=asterisk
Group=asterisk
RuntimeDirectory=asl-dashboard
RuntimeDirectoryMode=0755
StateDirectory=asl-dashboard
StateDirectoryMode=0755
ExecStart=/usr/bin/php /var/www/html/collector.php
Restart=always
RestartSec=5
# Kolektor nie potrzebuje sudo ani żadnych dodatkowych uprawnień -
# działa z tymi samymi prawami co Asterisk.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
